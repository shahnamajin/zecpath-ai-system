
{
  "policy_version": "1.0",
  "review_day": 43,
  "principles": {
    "fairness": true,
    "transparency": true,
    "privacy": true,
    "accountability": true,
    "human_oversight": true
  },
  "consent": {
    "require_candidate_notice": true,
    "require_consent_for_optional_ai_processing": true,
    "explain_ai_purpose": true,
    "explain_data_usage": true,
    "provide_contact_for_questions": true
  },
  "fairness": {
    "exclude_from_scoring": [
      "race",
      "ethnicity",
      "religion",
      "sex",
      "gender_identity",
      "disability",
      "date_of_birth",
      "marital_status"
