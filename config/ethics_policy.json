    "require_job_relevance": true,
    "require_consistent_scoring": true,
    "require_human_review_for_adverse_decisions": true
  },
  "explainability": {
    "record_score_components": true,
    "record_job_related_evidence": true,
    "record_missing_requirements": true,
    "allow_recruiter_review": true
  },
  "data_retention": {
    "require_documented_retention_period": true,
    "require_deletion_process": true,
    "require_access_controls": true,
    "require_audit_logging": true,
    "retention_days": null
  },
  "compliance": {
    "status": "pending_review",
    "legal_review_required": true,
    "privacy_review_required": true,
    "fairness_validation_required": true
  }
